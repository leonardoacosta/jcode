{
  "name": "@jcode/command-center",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vinxi dev --host 127.0.0.1",
    "build": "vinxi build",
    "start": "vinxi start --host 127.0.0.1",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint src tests e2e --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node ./e2e/run-playwright.mjs"
  },
  "dependencies": {
    "@solidjs/router": "0.15.4",
    "@solidjs/start": "1.3.2",
    "solid-js": "1.9.14",
    "vinxi": "0.5.11"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@solidjs/testing-library": "0.8.10",
    "@testing-library/jest-dom": "6.10.0",
    "@types/node": "22.20.1",
    "@typescript-eslint/eslint-plugin": "8.66.0",
    "@typescript-eslint/parser": "8.66.0",
    "eslint": "9.39.5",
    "eslint-plugin-solid": "0.14.5",
    "jsdom": "26.1.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "vite": "6.4.3",
    "vite-plugin-solid": "2.11.8",
    "vitest": "3.2.7"
  },
  "packageManager": "pnpm@10.24.0"
}
