{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",

  "entry": [
    "apps/*/instrumentation.{ts,js}",
    "apps/*/instrumentation-client.{ts,js}",
    "apps/*/middleware.{ts,js}",
    "apps/*/src/instrumentation.{ts,js}",
    "apps/*/src/instrumentation-client.{ts,js}",
    "apps/*/src/middleware.{ts,js}",
    "apps/*/next.config.{ts,js,mjs,cjs}",
    "apps/*/sentry.{server,client,edge}.config.{ts,js}",
    "apps/*/vercel.{ts,js}"
  ],

  "includeEntryExports": true,

  "ignorePatterns": [
    "**/*.generated.{ts,tsx,js,jsx}",
    "**/_generated/**",
    "**/drizzle/migrations/**",
    "**/.next/**",
    "**/.turbo/**",
    "**/.vercel/**",
    "**/dist/**",
    "**/build/**",
    "**/out/**",
    "**/coverage/**",
    "**/playwright-report/**",
    "**/test-results/**",
    "apps/ios/Sources/OtakuOdyssey/Models/Generated/**",
    "tooling/codemods/**/__fixtures__/**",
    "update-settings.ts",
    "update-badge-addon.js",
    "test.js"
  ],

  "ignoreExports": [
    {
      "_comment": "ESLint rule files — every rule exports `meta` + `create` per the Rule.RuleModule contract. Same-name dupe is structural, not an API issue.",
      "file": "tooling/eslint/rules/*.cjs",
      "exports": ["meta", "create"]
    },
    {
      "_comment": "Sibling content services share the same CRUD vocabulary (create/update/reorder/listByContentPageId) by contract. Same-name dupe is the interface, not an accident.",
      "file": "packages/api/src/services/content/content-page-service.ts",
      "exports": ["create", "update", "reorder", "listByContentPageId"]
    },
    {
      "file": "packages/api/src/services/content/faq-entry-service.ts",
      "exports": ["create", "update", "reorder", "listByContentPageId"]
    },
    {
      "file": "packages/api/src/services/content/survival-guide-image-service.ts",
      "exports": ["create", "update", "reorder", "listByContentPageId"]
    },
    {
      "_comment": "Entity-image facade — public API per `migrate-entity-image-service` contract. Per-concern impl modules retain their exports for testability; the facade re-exports them under the same names.",
      "file": "packages/api/src/services/staff/entity-image-service.ts",
      "exports": [
        "clearSingleImage",
        "setSingleImage",
        "listEntityImagesBatch",
        "reorderEntityImages",
        "updateUserImage",
        "updateEntityImageCaption",
        "softDeleteEntityImage",
        "uploadEntityImage"
      ]
    },
    {
      "_comment": "formatCurrency / formatDate / formatRelativeTime have intentionally distinct contextual implementations (UI-side vs email-template vs e2e fixture-side). See `dedupe-shared-types` Bucket D rationale.",
      "file": "apps/nextjs/src/lib/format-utils.ts",
      "exports": ["formatCurrency", "formatDate", "formatRelativeTime"]
    },
    {
      "file": "packages/api/src/infra/email/components/utils.ts",
      "exports": ["formatCurrency", "formatDate"]
    },
    {
      "_comment": "Stricter ValidationRules-side `isBogoConfiguration` runtime — keeps the number-type assertion the ValidationRules consumers rely on, separate from the loose presence-check shared variant.",
      "file": "apps/nextjs/src/components/staff/promo-codes/edit/ValidationRules.tsx",
      "exports": ["isBogoConfiguration"]
    },
    {
      "_comment": "Legacy (db, productId, quantity, pricingTier) shape kept for the admin manual-vendor-creation path. New code should import from pricing-service directly.",
      "file": "packages/api/src/services/vendor-applications/application-helpers.ts",
      "exports": ["calculateBoothPrice"]
    },
    {
      "_comment": "BadgeTypeFilters: same name across an api-service interface and a UI component file. Different package surfaces; not a real collision.",
      "file": "apps/nextjs/src/components/features/badges/badge-types/BadgeTypeFilters.tsx",
      "exports": ["BadgeTypeFilters"]
    }
  ],

  "ignoreDependencies": [
    "autoprefixer",
    "postcss",
    "tailwindcss",
    "@vercel/speed-insights",
    "@vercel/analytics",
    "@vercel/otel",

    "react",
    "react-dom",

    "zod",

    "@better-auth/cli",

    "@acme/prettier-config",
    "@acme/eslint-config",
    "@acme/tsconfig",
    "@acme/tailwind-config",
    "@acme/inventory",

    "@t3-oss/env-core",
    "@vercel/postgres",
    "dotenv",
    "glob",
    "metro-cache",
    "nanoid",
    "papaparse",
    "stripe",
    "typescript-eslint"
  ],

  "publicPackages": [
    "@acme/api",
    "@acme/auth",
    "@acme/db",
    "@acme/ui",
    "@acme/validators"
  ],

  "rules": {
    "unused-files": "error",
    "unused-exports": "warn",
    "unused-types": "warn",
    "unused-dependencies": "error",
    "unused-dev-dependencies": "warn",
    "circular-dependencies": "error",
    "boundary-violation": "error",
    "duplicate-exports": "warn",
    "private-type-leaks": "warn",
    "stale-suppressions": "warn",
    "unresolved-catalog-references": "error",
    "unused-catalog-entries": "warn"
  },

  "duplicates": {
    "enabled": true,
    "mode": "mild",
    "minTokens": 50,
    "minLines": 5,
    "minOccurrences": 2,
    "skipLocal": true
  },

  "health": {
    "maxCyclomatic": 20,
    "maxCognitive": 12,
    "maxCrap": 30.0
  },

  "boundaries": {
    "zones": [
      {
        "name": "ui",
        "patterns": ["apps/*/src/**", "packages/ui/**"]
      },
      {
        "name": "data",
        "patterns": ["packages/db/**"]
      },
      {
        "name": "api",
        "patterns": ["packages/api/**"]
      },
      {
        "name": "auth",
        "patterns": ["packages/auth/**"]
      },
      {
        "name": "shared",
        "patterns": ["packages/validators/**", "packages/e2e/**"]
      },
      {
        "name": "tooling",
        "patterns": ["tooling/**"]
      }
    ],
    "rules": [
      { "from": "ui", "allow": ["api", "auth", "shared", "tooling"] },
      { "from": "api", "allow": ["data", "auth", "shared", "tooling"] },
      { "from": "auth", "allow": ["data", "shared", "tooling"] },
      { "from": "data", "allow": ["shared", "tooling"] },
      { "from": "shared", "allow": ["tooling"] },
      { "from": "tooling", "allow": [] }
    ]
  }
}
