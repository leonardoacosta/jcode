#!/usr/bin/env python3
"""Render normalized open-work JSON identically for every harness binding."""
import argparse
import json
from pathlib import Path


def bullet(identifier, title, detail=None):
    suffix = f" — {detail}" if detail else ""
    return f"- `{identifier}` — {title}{suffix}"


def section(lines, heading, rows):
    if not rows:
        return
    if lines:
        lines.append("")
    lines.extend([heading + ":", "", *rows])


def render(data):
    beads = data.get("beads") or {}
    states = beads.get("by_status") or {}
    opened = states.get("open", 0)
    progress = states.get("in_progress", 0)
    blocked_count = states.get("blocked", 0)
    unresolved = beads.get("total_open", opened + progress + blocked_count)
    lines = [
        f"{unresolved} Beads items remain unresolved: {opened} open, "
        f"{progress} in progress, {blocked_count} blocked."
    ]

    items = beads.get("items") or [] if beads.get("available") else []
    containers = beads.get("containers") or [] if beads.get("available") else []
    proposals = (data.get("proposals") or {}).get("items") or []

    progress_rows = [bullet(i.get("id"), i.get("title")) for i in items if i.get("bucket") == "in_progress"]
    progress_rows += [bullet(i.get("id"), i.get("title")) for i in containers if i.get("status") == "in_progress"]
    section(lines, "In progress", progress_rows)

    open_proposals = [p for p in proposals if p.get("state") not in ("done", "in-progress")]
    proposal_heading = "Only open proposal" if len(open_proposals) == 1 else f"Open proposals ({len(open_proposals)})"
    section(lines, proposal_heading, [bullet(p.get("name"), f"{p.get('tasks', '0/0')} tasks") for p in open_proposals])

    open_items = [i for i in items if i.get("bucket") == "open"]
    section(lines, "P1 work", [bullet(i.get("id"), i.get("title")) for i in open_items if i.get("priority") == 1])
    section(lines, "Other actionable work", [bullet(i.get("id"), i.get("title")) for i in open_items if i.get("priority") != 1])
    section(lines, "Open capability containers", [bullet(i.get("id"), i.get("title")) for i in containers if i.get("status") == "open"])

    section(lines, "Active OpenSpec changes", [bullet(p.get("name"), f"{p.get('tasks', '0/0')} tasks") for p in proposals if p.get("state") != "done"])
    section(lines, "Blocked", [bullet(i.get("id"), i.get("title"), i.get("bucket_reason")) for i in items if i.get("bucket") == "blocked"])
    section(lines, "Human-only", [bullet(i.get("id"), i.get("title"), i.get("bucket_reason")) for i in items if i.get("bucket") == "human_only"])

    plan_rows = []
    for directory in (data.get("plans") or {}).get("dirs") or []:
        plan_rows.extend(bullet(row.get("num"), row.get("title"), row.get("status")) for row in directory.get("open") or [])
    section(lines, "Open plan rows", plan_rows)
    section(lines, "Archive-ready proposals", [bullet(p.get("name"), f"{p.get('tasks', '0/0')} tasks") for p in proposals if p.get("state") == "done"])

    warnings = list(data.get("source_warnings") or [])
    for source in ("beads", "proposals", "plans", "docs_plan"):
        value = data.get(source) or {}
        if value.get("available") is False:
            warnings.append(f"{source} unavailable" + (f": {value['error']}" if value.get("error") else ""))
    section(lines, "Source warnings", [f"- {warning}" for warning in dict.fromkeys(warnings)])
    if beads.get("truncated"):
        lines.extend(["", f"Showing {len(items)} of {unresolved} Beads items — full list: `bd list`."])
    return "\n".join(lines)


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--inventory", required=True)
    parser.add_argument("--mode", choices=("report", "interactive"), default="interactive")
    parser.add_argument("--capabilities", default="respond,shell,delegate,apply")
    args = parser.parse_args()
    data = json.loads(Path(args.inventory).read_text())
    output = render(data)
    if args.mode == "interactive" and args.capabilities == "none":
        output += "\n\nActions unavailable: respond, shell, delegate, apply."
    print(output)


if __name__ == "__main__":
    main()
