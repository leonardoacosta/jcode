{
  "name": "@{ws}/scripts",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "with-env": "dotenvx run --overload --quiet -f ../../.env --",
    "with-test-env": "dotenvx run --overload --quiet -f ../../.env -f ../../.env.test --",
    "typecheck": "tsc --noEmit",
    "seed-example": "pnpm with-env tsx src/seed-example.ts"
  },
  "dependencies": {
    "@{ws}/db": "workspace:*"
  },
  "devDependencies": {
    "@{ws}/tsconfig": "workspace:*",
    "@dotenvx/dotenvx": "^1.34.0",
    "tsx": "^4.19.2",
    "typescript": "catalog:"
  }
}
