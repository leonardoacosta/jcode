{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jcode.dev/skills/isometric-system-map/topology-views.schema.json",
  "title": "Isometric System Map Topology Views",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "repository", "default_view", "runtime", "network", "pipelines"],
  "properties": {
    "version": { "const": 1 },
    "repository": { "$ref": "#/$defs/repository" },
    "default_view": { "enum": ["runtime", "network", "ado"] },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_ids", "path_ids"],
      "properties": {
        "node_ids": { "$ref": "#/$defs/stringArray", "uniqueItems": true },
        "path_ids": { "$ref": "#/$defs/stringArray", "uniqueItems": true },
        "flow_ids": { "$ref": "#/$defs/stringArray", "uniqueItems": true }
      }
    },
    "network": { "$ref": "#/$defs/network" },
    "pipelines": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/pipeline" }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "stringArray": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/nonEmptyString" }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "lines", "claim"],
      "properties": {
        "path": { "$ref": "#/$defs/nonEmptyString" },
        "lines": { "$ref": "#/$defs/nonEmptyString" },
        "claim": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "ref", "commit"],
      "properties": {
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "ref": { "$ref": "#/$defs/nonEmptyString" },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{40}$"
        }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": ["containers", "memberships", "links"],
      "properties": {
        "containers": {
          "type": "array",
          "items": { "$ref": "#/$defs/networkContainer" }
        },
        "memberships": {
          "type": "array",
          "items": { "$ref": "#/$defs/networkMembership" }
        },
        "links": {
          "type": "array",
          "items": { "$ref": "#/$defs/networkLink" }
        }
      }
    },
    "networkContainer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "label", "status", "evidence"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "kind": { "enum": ["subscription", "resource-group", "vnet", "subnet"] },
        "label": { "$ref": "#/$defs/nonEmptyString" },
        "status": { "$ref": "#/$defs/nonEmptyString" },
        "cidr": { "type": "string", "minLength": 1 },
        "parent_id": { "$ref": "#/$defs/nonEmptyString" },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/evidence" }
        }
      }
    },
    "networkMembership": {
      "type": "object",
      "additionalProperties": false,
      "required": ["container_id", "node_id", "evidence"],
      "properties": {
        "container_id": { "$ref": "#/$defs/nonEmptyString" },
        "node_id": { "$ref": "#/$defs/nonEmptyString" },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/evidence" }
        }
      }
    },
    "networkLink": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "source_id", "target_id", "direction", "evidence_level", "label", "evidence"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "kind": { "enum": ["peering", "private-endpoint", "dns", "data"] },
        "source_id": { "$ref": "#/$defs/nonEmptyString" },
        "target_id": { "$ref": "#/$defs/nonEmptyString" },
        "direction": { "enum": ["forward", "reverse", "both"] },
        "evidence_level": { "enum": ["direct", "inferred", "held"] },
        "label": { "$ref": "#/$defs/nonEmptyString" },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/evidence" }
        }
      }
    },
    "pipeline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "stages", "edges"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "label": { "$ref": "#/$defs/nonEmptyString" },
        "stages": {
          "type": "array",
          "items": { "$ref": "#/$defs/pipelineStage" }
        },
        "edges": {
          "type": "array",
          "items": { "$ref": "#/$defs/pipelineEdge" }
        }
      }
    },
    "pipelineStage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "stage_type", "icon", "status", "evidence"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "label": { "$ref": "#/$defs/nonEmptyString" },
        "stage_type": { "enum": ["repository", "validation", "build", "artifact", "gate", "deployment", "held"] },
        "icon": { "$ref": "#/$defs/nonEmptyString" },
        "status": { "$ref": "#/$defs/nonEmptyString" },
        "parallel_group": { "$ref": "#/$defs/nonEmptyString" },
        "lane": { "type": "integer", "minimum": 0 },
        "target_node_id": { "$ref": "#/$defs/nonEmptyString" },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/evidence" }
        }
      }
    },
    "pipelineEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source_id", "target_id", "label", "kind", "evidence"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "source_id": { "$ref": "#/$defs/nonEmptyString" },
        "target_id": { "$ref": "#/$defs/nonEmptyString" },
        "label": { "$ref": "#/$defs/nonEmptyString" },
        "kind": { "enum": ["automatic", "dependency", "approval", "manual", "held"] },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/evidence" }
        }
      }
    }
  }
}
