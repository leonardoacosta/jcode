{
  "mcpServers": {
    "1password": {
      "command": "/usr/bin/1password-mcp",
      "timeout_secs": 300
    },
    "graft": {
      "command": "graft",
      "args": ["mcp"],
      "shared": true
    },
    "shadcn": {
      "command": "sh",
      "args": [
        "-c",
        "if [ -z \"${OP_SERVICE_ACCOUNT_TOKEN:-}\" ]; then OP_SERVICE_ACCOUNT_TOKEN=$(sed -n 's/^OP_SERVICE_ACCOUNT_TOKEN=//p' \"$HOME/.env\" | head -1); export OP_SERVICE_ACCOUNT_TOKEN; fi; export CODEDVISUALS_TOKEN=$(op read 'op://JCode CLI/CODEDVISUALS_TOKEN/credential'); exec npx -y shadcn@latest mcp"
      ],
      "timeout_secs": 120,
      "shared": false
    },
    "xapi": {
      "command": "/home/nyaptor/.local/bin/mcp-x",
      "timeout_secs": 120
    },

