[Unit]
Description=Authenticated VNC access to the homelab Wayland desktop
After=graphical.target
Wants=graphical.target

[Service]
Type=simple
User=nyaptor
Environment=WAYLAND_DISPLAY=wayland-1
Environment=XDG_RUNTIME_DIR=/run/user/1000
ExecStart=/usr/bin/wayvnc --config=/home/nyaptor/.config/wayvnc/config
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical.target
