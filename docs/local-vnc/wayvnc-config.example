# Homelab desktop VNC endpoint. Authentication uses the Linux account via PAM.
# Keep the real config at /home/nyaptor/.config/wayvnc/config with mode 0600.
# Do not commit usernames, passwords, private keys, or certificate material.
address=0.0.0.0
port=5900
enable_auth=true
enable_pam=true
certificate_file=/home/nyaptor/.config/wayvnc/server.crt
private_key_file=/home/nyaptor/.config/wayvnc/server.key
username=<local-linux-user>
